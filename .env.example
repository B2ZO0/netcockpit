# ============================================================
#  Supervision : réglages et secrets
#  ./setup.sh crée .env à partir de ce fichier (mots de passe générés)
#  Réseaux, bâtiments, équipements à surveiller : config/cockpit.yml
#  Mot de passe contenant un $ : mets la valeur entre apostrophes, ex. VCENTER_PASSWORD='pa$$word'
# ============================================================

TZ=Europe/Paris
RETENTION=30d

# Image du cockpit : auto = téléchargée toute prête depuis ghcr.io (rien à construire), construite ici si elle n'est pas disponible.
# build = toujours la construire sur cette machine (pas d'accès à ghcr.io, code du cockpit modifié). Ton miroir : registre.example.local/netcockpit
COCKPIT_IMAGE=auto

# Adresse de la machine de supervision (liens dans les alertes et entre les outils)
PUBLIC_HOST=

# --- Connexion au cockpit (port 8088) ---
COCKPIT_PASSWORD=__RANDOM__
COCKPIT_SECRET=__RANDOM__
# off = pas de mot de passe (lab perso uniquement)
COCKPIT_AUTH=on
# Écran mural sans connexion : adresses autorisées, ex. 192.0.2.50/32,10.0.9.0/24
COCKPIT_TRUSTED_NETWORKS=
COCKPIT_SESSION_HOURS=12
# /metrics (inventaire complet) n'est lisible sans connexion que par cette machine et ses conteneurs Docker.
# Un Prometheus externe : ajoute son adresse ici, ex. 192.0.2.10/32
COCKPIT_METRICS_NETWORKS=

# --- Grafana ---
GRAFANA_ADMIN_PASSWORD=__RANDOM__

# --- Zabbix (VMware natif, découverte SNMP). false pour ne pas l'installer (économise ~1,5 Go de RAM)
ENABLE_ZABBIX=true
ZABBIX_WEB_PORT=8081
ZABBIX_ADMIN_PASSWORD=__RANDOM__
ZABBIX_GRAFANA_PASSWORD=__RANDOM__
ZABBIX_DB_PASSWORD=__RANDOM__

# --- VMware vCenter (compte en lecture seule : rôle "Read-only" à la racine, propagé)
VCENTER_URL=
VCENTER_USER=
VCENTER_PASSWORD=
# true = vérifier le certificat de vCenter (il doit être signé par une autorité connue du système)
VCENTER_VERIFY_TLS=false

# --- Proxmox VE (jeton d'API en lecture seule, rôle PVEAuditor : voir docs/getting-started.md)
#     PROXMOX_URL=https://pve.example.local:8006   PROXMOX_TOKEN_ID=netcockpit@pve!cockpit
PROXMOX_URL=
PROXMOX_TOKEN_ID=
PROXMOX_TOKEN_SECRET=
PROXMOX_VERIFY_TLS=

# --- SNMP (communauté en lecture seule donnée par le prestataire ; IP des équipements dans config/cockpit.yml)
SNMP_COMMUNITY=

# --- Analyse IA (optionnelle). Les données de supervision concernées sont envoyées au fournisseur choisi.
#  Anthropic :       AI_PROVIDER=anthropic  AI_API_KEY=sk-ant-...         (AI_MODEL facultatif)
#  Modèle local :    AI_PROVIDER=openai     AI_BASE_URL=http://IP:11434/v1  AI_MODEL=llama3.1   (Ollama, rien ne sort du réseau)
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=

# --- Notifications (laisser vide ce que tu n'utilises pas)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
ALERT_EMAIL_TO=
SMTP_SMARTHOST=smtp.mondomaine.fr:587
SMTP_FROM=supervision@mondomaine.fr
SMTP_USER=
SMTP_PASSWORD=
# Alertes "info" (nouvel appareil, redémarrage...) envoyées ? (true/false)
NOTIFY_INFO=true

