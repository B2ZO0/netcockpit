# ============================================================
#  Supervision : réglages et secrets
#  ./setup.sh crée .env à partir de ce fichier (mots de passe générés)
#  Réseaux, bâtiments, équipements à surveiller : config/cockpit.yml
#  Mot de passe contenant un $ : mets la valeur entre apostrophes, ex. VCENTER_PASSWORD='pa$$word'
# ============================================================

TZ=Europe/Paris
RETENTION=30d

# Adresse de la machine de supervision (liens dans les alertes et entre les outils)
PUBLIC_HOST=10.10.0.50

# --- Grafana ---
GRAFANA_ADMIN_PASSWORD=__RANDOM__

# --- Zabbix (VMware natif, découverte SNMP). false pour ne pas l'installer (économise ~1,5 Go de RAM)
ENABLE_ZABBIX=true
ZABBIX_WEB_PORT=8081
ZABBIX_ADMIN_PASSWORD=__RANDOM__
ZABBIX_GRAFANA_PASSWORD=__RANDOM__
ZABBIX_DB_PASSWORD=__RANDOM__

# --- VMware vCenter (compte en lecture seule : rôle "Read-only" à la racine, propagé)
VCENTER_URL=
VCENTER_USER=
VCENTER_PASSWORD=

# --- SNMP (communauté en lecture seule donnée par le prestataire ; IP des équipements dans config/cockpit.yml)
SNMP_COMMUNITY=

# --- Analyse IA (optionnelle). Les données de supervision concernées sont envoyées au fournisseur choisi.
#  Anthropic :       AI_PROVIDER=anthropic  AI_API_KEY=sk-ant-...         (AI_MODEL facultatif)
#  Modèle local :    AI_PROVIDER=openai     AI_BASE_URL=http://IP:11434/v1  AI_MODEL=llama3.1   (Ollama, rien ne sort du réseau)
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=

# --- Notifications (laisser vide ce que tu n'utilises pas)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
ALERT_EMAIL_TO=
SMTP_SMARTHOST=smtp.mondomaine.fr:587
SMTP_FROM=supervision@mondomaine.fr
SMTP_USER=
SMTP_PASSWORD=
# Alertes "info" (nouvel appareil, redémarrage...) envoyées ? (true/false)
NOTIFY_INFO=true

